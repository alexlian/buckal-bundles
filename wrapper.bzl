    resolving `platform = {...}` against the reindeer platform select, with the
    build-script variant when the crate is a build script -- is kept, so the
    only difference between the two paths is whether lints can fire.
    """

    if crate == "build_script_build":
        kwargs = apply_platform_attrs_for_buildscript_build(platform, kwargs)
    else:
        kwargs = apply_platform_attrs(platform, kwargs)

    native.rust_binary(name = name, crate = crate, **kwargs)

def _first_party_rust_library(name, platform = {}, **kwargs):
    """
    `cargo.rust_library` minus the lint cap -- see `_first_party_rust_binary`.

    `doctests = False` is preserved rather than flipped: buckal doesn't
    generate doctest targets, so enabling them here would change what gets
    built, and this change is scoped to what gets *linted*.
