# Vendored crates are generated under `third-party/rust` (cargo-buckal's
# `RUST_ROOT`); every other package in the repo is first-party.
#
# The distinction decides whether a target may be built through the prelude's
# `cargo_package.bzl` helpers, which unconditionally prepend
# `--cap-lints=allow`. That is correct for vendored code and wrong for ours --
# the prelude's own header says so: "These should not be used for first-party
# code where lints are desired." `--cap-lints` is a *cap*, so routing
# first-party crates through them doesn't merely drop clippy's advice, it makes
# every lint level the workspace configures unreachable, `deny` included.
_THIRD_PARTY_ROOT = "third-party/rust"

def _is_third_party():
    package = package_name()
    return package == _THIRD_PARTY_ROOT or package.startswith(_THIRD_PARTY_ROOT + "/")

